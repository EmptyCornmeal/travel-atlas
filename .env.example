# Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Allowlisted emails (comma-separated)
VITE_ALLOWLISTED_EMAILS=myles@example.com,viktoria@example.com

# User configuration (JSON object mapping emails to names and colors)
# Myles = Blue, Viktoria = Red
VITE_USER_CONFIG={"myles@example.com":{"name":"Myles","color":"blue"},"viktoria@example.com":{"name":"Viktoria","color":"red"}}
